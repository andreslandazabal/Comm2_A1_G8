blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '32000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 12]
    rotation: 0
    state: enabled
- name: analog_sig_source_x_0
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '1'
    comment: ''
    freq: '1000'
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    showports: 'False'
    type: float
    waveform: analog.GR_COS_WAVE
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [40, 192.0]
    rotation: 0
    state: enabled
- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \n    def __init__(self):\n        gr.sync_block.__init__(\n            self,\n\
      \            name=\"e_Diff\",\n            in_sig=[np.float32],\n          \
      \  out_sig=[np.float32]\n        )\n\n        # Memoria del \xFAltimo valor\
      \ de entrada\n        self.x_anterior = np.float32(0)\n\n    def work(self,\
      \ input_items, output_items):\n\n        x = input_items[0]\n        y0 = output_items[0]\n\
      \n        N = len(x)\n        if N == 0:\n            return 0\n\n        #\
      \ Diferencia dentro del buffer\n        y0[0] = x[0] - self.x_anterior\n   \
      \     y0[1:] = x[1:] - x[:-1]\n\n        # Guardar \xFAltimo valor para siguiente\
      \ buffer\n        self.x_anterior = x[N - 1]\n\n        return N"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('e_Diff', 'blk', [], [('0', 'float', 1)], [('0', 'float', 1)], '',
      [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [360, 232.0]
    rotation: 0
    state: enabled
- name: qtgui_sink_x_0
  id: qtgui_sink_x
  parameters:
    affinity: ''
    alias: ''
    bw: samp_rate
    comment: ''
    fc: '0'
    fftsize: '1024'
    gui_hint: ''
