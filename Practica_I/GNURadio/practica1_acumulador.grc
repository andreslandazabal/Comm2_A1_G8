- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \n    def __init__(self):\n        gr.sync_block.__init__(\n            self,\n\
      \            name=\"e_Acum\",\n            in_sig=[np.float32],\n          \
      \  out_sig=[np.float32]\n        )\n\n        # Estado interno (memoria)\n \
      \       self.acum_anterior = np.float32(0)\n\n    def work(self, input_items,\
      \ output_items):\n\n        x = input_items[0]\n        y0 = output_items[0]\n\
      \n        N = len(x)\n        if N == 0:\n            return 0\n\n        #\
      \ Acumulado continuo\n        cumsum_local = np.cumsum(x)\n        y0[:] = cumsum_local\
      \ + self.acum_anterior\n\n        # Actualizar estado para siguiente buffer\n\
      \        self.acum_anterior = y0[N - 1]\n\n        return N"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('e_Acum', 'blk', [], [('0', 'float', 1)], [('0', 'float', 1)], '',
      [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [624, 280.0]
    rotation: 0
    state: enabled
- name: qtgui_sink_x_0
  id: qtgui_sink_x
  parameters:
    affinity: ''
